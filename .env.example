# Copia este fichero a .env y rellena los valores reales.
# .env está en .gitignore — NUNCA lo commitees.
# Este .env.example sí se commitea: documenta qué variables necesita el proyecto.

# --- Base de datos ---
# Local: SQLite en modo WAL. Docker: Postgres.
DATABASE_URL=sqlite:///data/cvp.sqlite3
# DATABASE_URL=postgresql://cvp:cvp@db:5432/cvp

# --- API ---
CVP_API_HOST=127.0.0.1
CVP_API_PORT=8000
# Orígenes permitidos para el dashboard en desarrollo
CVP_CORS_ORIGINS=http://localhost:5173

# --- Worker ---
# Directorio donde se cachean los pesos de los modelos. No se commitea.
CVP_MODELS_DIR=models
# DEBUG | INFO | WARNING
CVP_LOG_LEVEL=INFO
# Hilos de PyTorch. En un portátil de 15 W, más hilos no significa más fps:
# medir antes de subirlo.
CVP_TORCH_THREADS=4

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# Sin claves de servicios externos: toda la inferencia corre en local.
